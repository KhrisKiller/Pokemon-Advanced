[gd_resource type="Resource" script_class="ShopData" format=3]

[ext_resource type="Script" path="res://game/economy/shop_data.gd" id="1_shop"]
[ext_resource type="Script" path="res://game/economy/shop_offer.gd" id="2_offer"]

[sub_resource type="Resource" id="Offer_0"]
script = ExtResource("2_offer")
item_id = &"pipweed_seed"
price = 20

[sub_resource type="Resource" id="Offer_1"]
script = ExtResource("2_offer")
item_id = &"emberroot_seed"
price = 40

[sub_resource type="Resource" id="Offer_2"]
script = ExtResource("2_offer")
item_id = &"bluecap_seed"
price = 30

[resource]
script = ExtResource("1_shop")
id = &"seed_shop"
display_name = "Pell's Seeds"
greeting = "Seeds, fresh in from the coast. What'll it be?"
offers = Array[ExtResource("2_offer")]([SubResource("Offer_0"), SubResource("Offer_1"), SubResource("Offer_2")])
